{
  "manifest_version": 3,
  "name": "YSP HLS Recorder",
  "version": "0.1.0",
  "description": "DevTools helper for selecting a player, capturing ordinary HLS streams, and recording them as TS files.",
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "devtools_page": "devtools.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "storage.js",
        "recorder.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YSP HLS Recorder"
  }
}
