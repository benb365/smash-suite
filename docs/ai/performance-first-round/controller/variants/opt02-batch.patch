+    def predict_batch(self, images, statistics=None):
+        if len(images) == 1:
+            return [self(images[0], statistics)]
+        if len(images) != 2:
+            raise ValueError("PoseEstimator batches must contain one or two images")
+        tensors = [self._prepare(image, statistics) for image in images]
+        import time
+        enabled = statistics is not None and statistics.enabled
+        tick = time.monotonic() if enabled else None
+        with self.torch.inference_mode():
+            outputs = self.model(tensors)
+        if enabled:
+            statistics.timing("pose_model_call_s", time.monotonic() - tick)
+        return [self._convert(output, statistics) for output in outputs]
