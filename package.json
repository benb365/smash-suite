{
  "name": "smash-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Local badminton video modules and applications.",
  "scripts": {
    "dev:frontend": "pnpm -C apps/video-clipper/frontend build",
    "dev:backend": "node scripts/python.mjs -m app",
    "build:product": "node scripts/python.mjs apps/video-clipper/packaging/build.py",
    "test:backend": "node scripts/python.mjs -m pytest",
    "typecheck:frontend": "pnpm -C apps/video-clipper/frontend exec tsc --noEmit",
    "docs:dev": "pnpm -C tools/docs-site dev",
    "docs:build": "pnpm -C tools/docs-site build",
    "docs:preview": "pnpm -C tools/docs-site preview"
  },
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=9"
  }
}
