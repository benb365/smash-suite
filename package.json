{
  "name": "smash-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone local badminton video clipping application.",
  "scripts": {
    "dev:frontend": "pnpm -C frontend build",
    "dev:backend": "cd backend && ../.venv/bin/python -m app",
    "build:product": ".venv/bin/python tools/package/build.py",
    "test:backend": "cd backend && python3 -m pytest",
    "typecheck:frontend": "pnpm -C frontend exec tsc --noEmit"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
